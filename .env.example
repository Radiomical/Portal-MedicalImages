# Variable-name reference only. Every assignment is intentionally empty.
# Do not use this whole file unchanged. Create separate private files described
# in deploy/README.md and set every variable required by the chosen mode.

# Compose selection file (not passed into application containers)
PORTAL_COMPOSE_ENV_FILE=
PORTAL_IMAGE=
PORTAL_PRODUCTION_ENV_FILE=
PORTAL_STAGING_ENV_FILE=
PORTAL_TUNNEL_ENV_FILE=
PORTAL_DATABASE_CA_FILE=

# Application identity and HTTPS
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
ADMIN_URL_PATH=
TRUST_PROXY_HTTPS=
SECURE_COOKIES=
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=

# Database (production: external PostgreSQL with verify-full)
DB_ENGINE=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSLMODE=
DATABASE_SSLROOTCERT=

# Storage (production: R2, separate image and DICOM buckets)
MEDIA_STORAGE=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_IMAGE_BUCKET=
R2_DICOM_BUCKET=
R2_IMAGE_PUBLIC_BASE_URL=
R2_SIGNED_URL_SECONDS=
DICOM_RETENTION_ENABLED=
CASE_MEDIA_DUAL_WRITE=
CASE_MEDIA_NORMALIZED_READ=
MAX_UPLOAD_FILES=
MAX_IMAGE_UPLOAD_BYTES=
MAX_CASE_UPLOAD_BYTES=
MAX_IMAGE_PIXELS=

# Transactional mail (Resend pins host, port and STARTTLS)
EMAIL_PROVIDER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
DEFAULT_REPLY_TO_EMAIL=

# Custom SMTP mode only
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_USE_TLS=

# Optional filesystem paths (preview/local tooling only; production uses R2)
STATIC_ROOT=
MEDIA_ROOT=
PRIVATE_DICOM_ROOT=
SQLITE_PATH=

# Connector-only private file. Never pass this file to web.
TUNNEL_TOKEN=
