# Optional transactional-mail settings. Inject at container startup, never at build time.
# Merge with the required deployment settings documented in README.md.
# No SMTP credential or real address belongs in this example.
EMAIL_PROVIDER=custom
DEFAULT_REPLY_TO_EMAIL=
# To enable replies, set DEFAULT_REPLY_TO_EMAIL to one monitored email address.
# The sending identity remains independently configured via DEFAULT_FROM_EMAIL.
# Production secrets must come from the environment/secret store, not this file.

# One URL segment with a trailing slash. Set only at deployment.
ADMIN_URL_PATH=xxx/
